# Copiar este archivo a .env.local y completar con credenciales reales.
# .env.local NUNCA debe commitearse (ver .gitignore). Este archivo (.env.example)
# no debe contener secretos reales, solo nombres de variables y valores de ejemplo.

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------

# URL pública canónica de la aplicación (sin barra final).
# En desarrollo: http://localhost:3000
# En producción: la URL del dominio definitivo, cuando esté disponible.
# Se usa para: back_urls de Mercado Pago, URL del webhook, enlaces en emails.
# No hardcodear el dominio en el código: siempre leer esta variable.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# URL y clave anónima del proyecto Supabase. Son públicas por diseño
# (protegidas por RLS), se exponen al navegador vía NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme

# Service role key: acceso total, bypassea RLS. SOLO uso server-side
# (Route Handlers, Server Actions, Server Components). Jamás debe llevar
# el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=changeme

# ---------------------------------------------------------------------------
# Mercado Pago — Checkout Pro
# (usadas a partir de la Fase 3; no se consumen todavía en la Fase 1)
# ---------------------------------------------------------------------------

# Access Token de la aplicación en Mercado Pago Developers.
# Usar credenciales de PRUEBA en desarrollo, nunca credenciales reales
# en el repositorio. Server-only.
MERCADOPAGO_ACCESS_TOKEN=changeme

# Clave secreta de verificación de webhooks, obtenida en
# Mercado Pago Developers > Tus integraciones > [tu app] > Webhooks.
# Se usa para validar la firma del header x-signature. Server-only.
MERCADOPAGO_WEBHOOK_SECRET=changeme

# ---------------------------------------------------------------------------
# Email transaccional — Resend
# (usadas a partir de la Fase 4; no se consumen todavía en la Fase 1)
# ---------------------------------------------------------------------------

RESEND_API_KEY=changeme

# Remitente verificado en Resend. No hardcodear en el código.
EMAIL_FROM_ADDRESS="The Pulse Project <entradas@example.com>"

# ---------------------------------------------------------------------------
# Variables reservadas para fases posteriores (documentadas, no usadas aún)
# ---------------------------------------------------------------------------

# Rate limiting (Fase 6) — Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Error tracking (Fase 6) — Sentry
# SENTRY_DSN=
